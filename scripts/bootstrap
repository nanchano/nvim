#!/usr/bin/env bash

set -euo pipefail

readonly NVIM_VERSION="0.12.5"
readonly NVIM_SHA256="bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875"
readonly NVIM_ARCHIVE="nvim-linux-x86_64.tar.gz"
readonly NVIM_URL="https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/${NVIM_ARCHIVE}"
readonly FD_VERSION="10.4.2"
readonly FD_SHA256="e3257d48e29a6be965187dbd24ce9af564e0fe67b3e73c9bdcd180f4ec11bdde"
readonly FD_ARCHIVE="fd-v${FD_VERSION}-x86_64-unknown-linux-musl.tar.gz"
readonly FD_URL="https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/${FD_ARCHIVE}"

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
install_root="${XDG_DATA_HOME:-$HOME/.local/share}/nvim-bootstrap"
version_dir="$install_root/nvim-v$NVIM_VERSION"
bin_dir="${HOME}/.local/bin"
nvim_link="$bin_dir/nvim"

require_base_tools() {
	local missing=()
	local tool
	for tool in curl tar sha256sum git gcc g++ make gzip unzip node npm; do
		command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
	done
	if (( ${#missing[@]} != 0 )); then
		printf 'Missing base tools: %s\n' "${missing[*]}" >&2
		printf 'On Debian/Devuan, install them with:\n' >&2
		printf '  sudo apt install build-essential coreutils curl git gzip nodejs npm tar unzip\n' >&2
		exit 1
	fi
}

install_fd() {
	local temp_dir archive extracted
	if command -v fd >/dev/null 2>&1; then
		return
	fi
	if command -v fdfind >/dev/null 2>&1; then
		mkdir -p -- "$bin_dir"
		ln -sfn -- "$(command -v fdfind)" "$bin_dir/fd"
		return
	fi

	temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/fd-bootstrap.XXXXXX")
	archive="$temp_dir/$FD_ARCHIVE"
	curl --fail --location --show-error --silent "$FD_URL" --output "$archive"
	printf '%s  %s\n' "$FD_SHA256" "$archive" | sha256sum --check --status
	tar -xzf "$archive" -C "$temp_dir"
	extracted="$temp_dir/fd-v${FD_VERSION}-x86_64-unknown-linux-musl/fd"
	mkdir -p -- "$bin_dir"
	mv -- "$extracted" "$bin_dir/fd"
	chmod 0755 -- "$bin_dir/fd"
	rm -rf -- "$temp_dir"
}

install_neovim() {
	local temp_dir archive extracted
	if [[ -x "$version_dir/bin/nvim" ]]; then
		return
	fi

	temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/nvim-bootstrap.XXXXXX")
	archive="$temp_dir/$NVIM_ARCHIVE"
	curl --fail --location --show-error --silent "$NVIM_URL" --output "$archive"
	printf '%s  %s\n' "$NVIM_SHA256" "$archive" | sha256sum --check --status
	tar -xzf "$archive" -C "$temp_dir"
	extracted="$temp_dir/nvim-linux-x86_64"
	mkdir -p -- "$install_root"
	mv -- "$extracted" "$version_dir"
	rm -f -- "$archive"
	rmdir -- "$temp_dir"
}

link_neovim() {
	mkdir -p -- "$bin_dir"
	if [[ -e "$nvim_link" && ! -L "$nvim_link" ]]; then
		printf 'Refusing to replace non-symlink %s\n' "$nvim_link" >&2
		exit 1
	fi
	ln -sfn -- "$version_dir/bin/nvim" "$nvim_link"
}

check_neovim() {
	local version_line
	version_line=$("$nvim_link" --version | head -n 1)
	if [[ "$version_line" != "NVIM v$NVIM_VERSION" ]]; then
		printf 'Expected NVIM v%s, got: %s\n' "$NVIM_VERSION" "$version_line" >&2
		exit 1
	fi
	printf 'Neovim: %s (%s)\n' "$version_line" "$nvim_link"
}

require_base_tools
install_fd
install_neovim
link_neovim
check_neovim

PATH="$bin_dir:$PATH" "$nvim_link" --headless \
	'+Lazy! sync' \
	'+qa'

PATH="$bin_dir:$PATH" "$nvim_link" --headless '+MasonToolsInstallSync' '+qa'

NVIM_INSTALL_PARSERS=1 PATH="$bin_dir:$PATH" "$nvim_link" --headless '+qa'

PATH="$bin_dir:$PATH" "$repo_dir/scripts/check-nvim"

printf '\nBootstrap complete. Ensure %s precedes /usr/local/bin in PATH.\n' "$bin_dir"
