#!/usr/bin/env bash

set -euo pipefail

readonly NVIM_VERSION="0.12.5"
readonly FD_VERSION="10.3.0"

NVIM_ARCHIVE=""
NVIM_SHA256=""
NVIM_EXTRACTED_DIR=""
FD_ARCHIVE=""
FD_SHA256=""
FD_EXTRACTED_DIR=""
PLATFORM=""

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
install_root="${XDG_DATA_HOME:-$HOME/.local/share}/nvim-bootstrap"
version_dir="$install_root/nvim-v$NVIM_VERSION"
bin_dir="${HOME}/.local/bin"
nvim_link="$bin_dir/nvim"

detect_platform() {
	local kernel machine
	kernel=${NVIM_BOOTSTRAP_KERNEL:-$(uname -s)}
	machine=${NVIM_BOOTSTRAP_MACHINE:-$(uname -m)}

	case "$kernel:$machine" in
		Linux:x86_64)
			PLATFORM="linux-x86_64"
			NVIM_ARCHIVE="nvim-linux-x86_64.tar.gz"
			NVIM_SHA256="bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875"
			NVIM_EXTRACTED_DIR="nvim-linux-x86_64"
			FD_ARCHIVE="fd-v${FD_VERSION}-x86_64-unknown-linux-musl.tar.gz"
			FD_SHA256="2b6bfaae8c48f12050813c2ffe1884c61ea26e750d803df9c9114550a314cd14"
			FD_EXTRACTED_DIR="fd-v${FD_VERSION}-x86_64-unknown-linux-musl"
			;;
		Darwin:arm64)
			PLATFORM="macos-arm64"
			NVIM_ARCHIVE="nvim-macos-arm64.tar.gz"
			NVIM_SHA256="65fb000099e47ca1b762584c484cc833f40e30851a0ec450d4174e16317c1f9b"
			NVIM_EXTRACTED_DIR="nvim-macos-arm64"
			FD_ARCHIVE="fd-v${FD_VERSION}-aarch64-apple-darwin.tar.gz"
			FD_SHA256="0570263812089120bc2a5d84f9e65cd0c25e4a4d724c80075c357239c74ae904"
			FD_EXTRACTED_DIR="fd-v${FD_VERSION}-aarch64-apple-darwin"
			;;
		Darwin:x86_64)
			PLATFORM="macos-x86_64"
			NVIM_ARCHIVE="nvim-macos-x86_64.tar.gz"
			NVIM_SHA256="81f4518622cb059b450ee2e498c6a1082a222f6bd89589de5bbcf0c6a68aa3fd"
			NVIM_EXTRACTED_DIR="nvim-macos-x86_64"
			FD_ARCHIVE="fd-v${FD_VERSION}-x86_64-apple-darwin.tar.gz"
			FD_SHA256="50d30f13fe3d5914b14c4fff5abcbd4d0cdab4b855970a6956f4f006c17117a3"
			FD_EXTRACTED_DIR="fd-v${FD_VERSION}-x86_64-apple-darwin"
			;;
		*)
			printf 'Unsupported platform: %s %s\n' "$kernel" "$machine" >&2
			exit 1
			;;
	esac
}

print_platform() {
	printf 'platform=%s\n' "$PLATFORM"
	printf 'neovim=%s sha256=%s\n' "$NVIM_ARCHIVE" "$NVIM_SHA256"
	printf 'fd=%s sha256=%s\n' "$FD_ARCHIVE" "$FD_SHA256"
}

verify_checksum() {
	local checksum=$1
	local file=$2
	if command -v sha256sum >/dev/null 2>&1; then
		printf '%s  %s\n' "$checksum" "$file" | sha256sum --check --status
	else
		[[ $(shasum -a 256 "$file" | awk '{ print $1 }') == "$checksum" ]]
	fi
}

require_base_tools() {
	local missing=()
	local tool
	for tool in curl tar git cc c++ make gzip unzip node npm rg; do
		command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
	done
	if [[ $PLATFORM == macos-* ]] && ! command -v xattr >/dev/null 2>&1; then
		missing+=("xattr")
	fi
	if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
		missing+=("sha256sum or shasum")
	fi
	if (( ${#missing[@]} != 0 )); then
		printf 'Missing base tools: %s\n' "${missing[*]}" >&2
		if [[ $PLATFORM == linux-* ]]; then
			printf 'On Debian/Devuan, install them with:\n' >&2
			printf '  sudo apt install build-essential coreutils curl git gzip nodejs npm ripgrep tar unzip\n' >&2
		else
			printf 'On macOS, install the Xcode Command Line Tools, Node.js/npm, and ripgrep.\n' >&2
		fi
		exit 1
	fi
}

install_fd() {
	local temp_dir archive extracted
	if [[ -x "$bin_dir/fd" ]] && [[ $("$bin_dir/fd" --version) == "fd $FD_VERSION" ]]; then
		return
	fi
	if command -v fdfind >/dev/null 2>&1; then
		mkdir -p -- "$bin_dir"
		ln -sfn -- "$(command -v fdfind)" "$bin_dir/fd"
		return
	fi

	temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/fd-bootstrap.XXXXXX")
	archive="$temp_dir/$FD_ARCHIVE"
	curl --fail --location --show-error --silent \
		"https://github.com/sharkdp/fd/releases/download/v${FD_VERSION}/${FD_ARCHIVE}" \
		--output "$archive"
	verify_checksum "$FD_SHA256" "$archive"
	tar -xzf "$archive" -C "$temp_dir"
	extracted="$temp_dir/$FD_EXTRACTED_DIR/fd"
	mkdir -p -- "$bin_dir"
	mv -- "$extracted" "$bin_dir/fd"
	chmod 0755 -- "$bin_dir/fd"
	rm -rf -- "$temp_dir"
}

install_neovim() {
	local temp_dir archive extracted
	if [[ -x "$version_dir/bin/nvim" ]]; then
		return
	fi

	temp_dir=$(mktemp -d "${TMPDIR:-/tmp}/nvim-bootstrap.XXXXXX")
	archive="$temp_dir/$NVIM_ARCHIVE"
	curl --fail --location --show-error --silent \
		"https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/${NVIM_ARCHIVE}" \
		--output "$archive"
	verify_checksum "$NVIM_SHA256" "$archive"
	if [[ $PLATFORM == macos-* ]]; then
		xattr -c "$archive"
	fi
	tar -xzf "$archive" -C "$temp_dir"
	extracted="$temp_dir/$NVIM_EXTRACTED_DIR"
	mkdir -p -- "$install_root"
	mv -- "$extracted" "$version_dir"
	rm -f -- "$archive"
	rmdir -- "$temp_dir"
}

link_neovim() {
	mkdir -p -- "$bin_dir"
	if [[ -e "$nvim_link" && ! -L "$nvim_link" ]]; then
		printf 'Refusing to replace non-symlink %s\n' "$nvim_link" >&2
		exit 1
	fi
	ln -sfn -- "$version_dir/bin/nvim" "$nvim_link"
}

check_neovim() {
	local version_line
	version_line=$("$nvim_link" --version | head -n 1)
	if [[ "$version_line" != "NVIM v$NVIM_VERSION" ]]; then
		printf 'Expected NVIM v%s, got: %s\n' "$NVIM_VERSION" "$version_line" >&2
		exit 1
	fi
	printf 'Neovim: %s (%s)\n' "$version_line" "$nvim_link"
}

detect_platform
if [[ ${1:-} == "--print-platform" ]]; then
	print_platform
	exit 0
fi
if (( $# != 0 )); then
	printf 'Usage: %s [--print-platform]\n' "$0" >&2
	exit 2
fi
require_base_tools
install_fd
install_neovim
link_neovim
check_neovim

PATH="$bin_dir:$PATH" "$nvim_link" --headless \
	'+Lazy! sync' \
	'+qa'

PATH="$bin_dir:$PATH" "$nvim_link" --headless '+MasonToolsInstallSync' '+qa'

NVIM_INSTALL_PARSERS=1 PATH="$bin_dir:$PATH" "$nvim_link" --headless '+qa'

PATH="$bin_dir:$PATH" "$repo_dir/scripts/check-nvim"

printf '\nBootstrap complete for %s. Ensure %s precedes /usr/local/bin in PATH.\n' "$PLATFORM" "$bin_dir"
